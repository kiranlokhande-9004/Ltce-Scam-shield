# ---------------------------------------------------------------------------
# ScamShield backend environment variables
# Copy this file to ".env" and fill in your real values.
# NEVER commit .env to git. The key is only read by the server (Node process),
# never bundled into the browser.
# ---------------------------------------------------------------------------

# Kimi / Moonshot API key (server-side only).
KIMI_API_KEY=sk-your-moonshot-api-key

# Kimi API base URL.
# International: https://api.moonshot.ai/v1
# China:         https://api.moonshot.cn/v1
KIMI_BASE_URL=https://api.moonshot.ai/v1

# Vision-capable model name. "kimi-latest" routes to the newest Kimi model
# with vision support. You can pin a specific K3 vision build here if desired.
KIMI_MODEL=kimi-latest

# Port the Express API listens on (Vite proxies /api here in dev).
PORT=8787

# Max upload size in megabytes.
MAX_UPLOAD_MB=10
